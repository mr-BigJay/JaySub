#!/usr/bin/env bash
# Yek khat: curl -fsSL https://raw.githubusercontent.com/mr-BigJay/JaySub/cursor/vpn-customer-panel-6abb/scripts/repair | bash
set -euo pipefail

RAW_BASE="https://raw.githubusercontent.com/mr-BigJay/JaySub/cursor/vpn-customer-panel-6abb"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "Lotfan ba root ejra konid."
  exit 1
fi

INSTALL_DIR="${JAYSUB_INSTALL_DIR:-/var/www/vpn-panel}"

if [[ ! -d "$INSTALL_DIR" ]]; then
  echo "Peyda nashod $INSTALL_DIR — aval install:"
  echo "  curl -fsSL ${RAW_BASE}/scripts/install | bash"
  exit 1
fi

cd "$INSTALL_DIR"
if [[ -d .git ]]; then
  git pull --ff-only 2>/dev/null || git pull 2>/dev/null || true
fi

# Agar file-ha roye server ghadimi ast, az GitHub download kon
for f in scripts/ensure-database.sh scripts/verify-database.php scripts/install.php; do
  if [[ ! -f "$f" ]]; then
    echo "Download $f ..."
    curl -fsSL "${RAW_BASE}/${f}" -o "$f"
  fi
done
chmod +x scripts/ensure-database.sh 2>/dev/null || true

echo ""
echo "=== JaySub DB Repair ==="
read -rsp "Ramz-e admin (user: admin): " ADMIN_PASS </dev/tty
echo ""

bash scripts/ensure-database.sh "$ADMIN_PASS"

WEB_USER="www-data"
if id nginx &>/dev/null; then WEB_USER="nginx"; fi
mkdir -p storage/sessions logs
chown -R "${WEB_USER}:${WEB_USER}" storage logs
chmod -R 750 storage logs
chmod 770 storage/sessions

systemctl restart php8.3-fpm 2>/dev/null || systemctl restart php8.2-fpm 2>/dev/null || true
systemctl reload nginx 2>/dev/null || true

export JAYSUB_INSTALL_DIR="$INSTALL_DIR"
if [[ -f scripts/info ]]; then bash scripts/info; fi

echo ""
echo "Alan: https://$(php -r "\$c=require 'config/config.php'; echo parse_url(\$c['app']['url'],PHP_URL_HOST);")/admin/login"
echo "User: admin | Pass: (hamin ke zadid)"
