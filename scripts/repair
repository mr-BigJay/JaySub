#!/usr/bin/env bash
# curl -fsSL https://raw.githubusercontent.com/mr-BigJay/JaySub/cursor/vpn-customer-panel-6abb/scripts/repair | bash
set -euo pipefail

INSTALL_DIR="${JAYSUB_INSTALL_DIR:-/var/www/vpn-panel}"
[[ "$(id -u)" -eq 0 ]] || { echo "root lazem ast"; exit 1; }
[[ -d "$INSTALL_DIR" ]] || { echo "aval: curl .../scripts/install | bash"; exit 1; }

cd "$INSTALL_DIR"
git pull 2>/dev/null || true

read -rsp "Ramz admin (user: admin): " ADMIN_PASS </dev/tty
echo ""

DB_PASS=$(php -r "\$c=require 'config/config.php'; echo \$c['database']['password'];")
DB_PASS_SQL="${DB_PASS//\'/\'\'}"
mysql -e "CREATE DATABASE IF NOT EXISTS vpn_panel; ALTER USER IF EXISTS 'vpn_panel'@'localhost' IDENTIFIED BY '${DB_PASS_SQL}';" 2>/dev/null || \
mysql -e "CREATE DATABASE IF NOT EXISTS vpn_panel; CREATE USER IF NOT EXISTS 'vpn_panel'@'localhost' IDENTIFIED BY '${DB_PASS_SQL}'; GRANT ALL ON vpn_panel.* TO 'vpn_panel'@'localhost'; FLUSH PRIVILEGES;"

mkdir -p storage/sessions
echo -n "$ADMIN_PASS" > storage/.admin-init
chmod 600 storage/.admin-init
php scripts/install.php "$ADMIN_PASS"
php -r "require 'src/bootstrap.php'; \App\Database\SchemaUpgrade::apply(\App\Core\Database::pdo()); echo 'schema ok\n';" 2>/dev/null || true

WEB_USER=www-data
id nginx &>/dev/null && WEB_USER=nginx
chown -R "$WEB_USER:$WEB_USER" storage logs 2>/dev/null || true

NGINX_CFG="/etc/nginx/sites-available/jaysub-vpn-panel"
if [[ -f "$NGINX_CFG" ]]; then
  if grep -qE "root[[:space:]]+${INSTALL_DIR};" "$NGINX_CFG" && ! grep -qE "root[[:space:]]+${INSTALL_DIR}/public;" "$NGINX_CFG"; then
    sed -i "s|root ${INSTALL_DIR};|root ${INSTALL_DIR}/public;|g" "$NGINX_CFG"
    echo "Nginx root -> ${INSTALL_DIR}/public"
  fi
  if grep -q 'try_files $uri =404;' "$NGINX_CFG"; then
    sed -i 's|try_files \$uri =404;|try_files $uri /index.php$is_args$args;|g' "$NGINX_CFG"
    echo "Nginx /assets/ fallback -> index.php"
  fi
  nginx -t 2>/dev/null && systemctl reload nginx 2>/dev/null || true
fi

if [[ ! -f "$INSTALL_DIR/public/assets/css/app.css" ]]; then
  echo "WARNING: public/assets/css/app.css missing — git pull failed?"
else
  echo "OK UI assets: public/assets/css/app.css"
fi

systemctl restart php8.3-fpm nginx 2>/dev/null || true

bash scripts/info 2>/dev/null || true
echo "Tamam. safhe ro refresh konid."
